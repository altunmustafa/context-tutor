# Create .env locally and replace this value. Never commit a real API key.
GEMINI_API_KEY=replace-me
GEMINI_MODELS=gemini-2.5-flash-lite,gemini-3.1-flash-lite,gemini-3.5-flash-lite,gemini-3.7-flash
DEFAULT_GEMINI_MODEL=gemini-2.5-flash-lite

MAX_CONTENT_LENGTH=20000
MAX_QUIZ_QUESTIONS=10
MODEL_REQUEST_TIMEOUT=30s
RATE_LIMIT_REQUESTS_PER_MINUTE=10
GEMINI_CONCURRENCY_LIMIT=2

# Comma-separated IP addresses or CIDR prefixes. Leave empty unless a trusted reverse proxy sets the client address.
TRUSTED_PROXIES=
